{"time": 1791606761.0721939, "tool": "write_file", "arguments": {"path": "C:\\Users\\nagor\\Downloads\\python_gui\\gui_app.py", "content": "import tkinter as tk\nfrom tkinter import ttk, messagebox\n\nclass MyApp:\n    def __init__(self, root):\n        self.root = root\n        self.root.title(\"יישום GUI - Python\")\n        self.root.geometry(\"400x300\")\n        self.root.resizable(False, False)\n\n        # פריים ראשי\n        main_frame = ttk.Frame(root, padding=\"20\")\n        main_frame.pack(fill=tk.BOTH, expand=True)\n\n        # שורה עליונה - כותרת\n        title_label = ttk.Label(main_frame, text=\"ברוכים הבאים!\", font=(\"Arial\", 16, \"bold\"))\n        title_label.pack(pady=(0, 10))\n\n        # שדה טקסט\n        self.name_var = tk.StringVar()\n        name_entry = ttk.Entry(main_frame, textvariable=self.name_var, width=30)\n        name_entry.pack(pady=5)\n\n        # כפתור\n        btn = ttk.Button(main_frame, text=\"לחץ עליי\", command=self.on_click)\n        btn.pack(pady=10)\n\n        # תווית תוצאה\n        self.result_label = ttk.Label(main_frame, text=\"\", font=(\"Arial\", 12))\n        self.result_label.pack(pady=5)\n\n    def on_click(self):\n        name = self.name_var.get().strip()\n        if name:\n            self.result_label.config(text=f\"שלום, {name}!\")\n        else:\n            messagebox.showwarning(\"אזהרה\", \"נא להזין שם\")\n\nif __name__ == \"__main__\":\n    root = tk.Tk()\n    app = MyApp(root)\n    root.mainloop()\n"}, "result": {"ok": true, "path": "C:\\Users\\nagor\\Downloads\\python_gui\\gui_app.py", "bytes": 1367, "verified": true}}
